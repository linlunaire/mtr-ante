{
  "schemaVersion": 1,
  "id": "mtrsteamloco",
  "version": "${version}",
  "name": "YLM-ANTE",
  "description": "Custom models, scripting and rail tools for Yanling Metro (YLM). Based on ANTE; this Kotlin preview is not yet production-validated.",
  "authors": ["linlunaire", "Zbx1425", "Aphrodite281"],
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["cn.zbx1425.mtrsteamloco.fabric.MainFabric"],
    "client": ["cn.zbx1425.mtrsteamloco.fabric.MainFabricClient"],
    "modmenu": ["cn.zbx1425.mtrsteamloco.fabric.ModMenuApiImpl"]
  },
  "mixins": ["mtrsteamloco.mixins.json", "mtrsteamloco_fabric.mixins.json"],
  "accessWidener": "mtrsteamloco.accesswidener",
  "depends": {
    "java": ">=25",
    "minecraft": "26.2",
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.159.0+26.2",
    "architectury": ">=21.0.7 <22",
    "transit_core": ">=${transitCoreVersion} <1",
    "mtr": ">=${mtrVersion} <26.3"
  }
}
